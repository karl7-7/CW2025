<?import com.comp2042.gameUI.GameOverPanel?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?><!-- a controller is a Java class that manages the behavior and
      interaction logic for a specific FXML-defined user interface (UI) layout. It acts as the intermediary
      between the UI elements (defined in FXML) and the application's business logic.-->
<AnchorPane fx:controller="com.comp2042.gameUI.GuiController"
            xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/21"> <GridPane fx:id="brickPanel" vgap="1" hgap="1"/> <BorderPane styleClass="gameBoard" fx:id="gameBoard"> <center> <GridPane fx:id="gamePanel" hgap="1" vgap="1" layoutY="30" layoutX="40"/>
</center>
</BorderPane>
<Label fx:id="scoreLabel" text="Score: 0" layoutX="10" layoutY="10" styleClass="scoreClass"/>
<Label fx:id="levelLabel" text="Level: 1" layoutX="200" layoutY="10" styleClass="scoreClass"/>

<VBox fx:id="pauseMenu" alignment="CENTER" spacing="20" visible="false" styleClass="menu-overlay-dark"
      AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
<Label text="PAUSED" styleClass="menu-title"/>

<Button text="▶ RESUME" onAction="#pauseGame" styleClass="menu-button-primary"/>
<Button text="🏠 QUIT TO TITLE" styleClass="menu-button"/>
</VBox>
<Group fx:id="groupNotification" layoutX="14" layoutY="203"> <VBox alignment="CENTER"> <com.comp2042.gameUI.GameOverPanel fx:id="gameOverPanel"/> </VBox>
</Group>
<stylesheets> <URL value="@window_style.css"/>
</stylesheets>
        </AnchorPane>